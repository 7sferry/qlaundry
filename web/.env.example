# Copy this file to `.env` and adjust the values for your environment.

# Base URL of the QLaundry backend API.
# When the backend is unreachable the app falls back to bundled mock data.
VITE_API_BASE_URL=http://localhost:7777

# Cloudflare Turnstile site key used by the registration page's captcha widget.
VITE_TURNSTILE_SITE_KEY=
